{
  "mcpServers": {
    "telegram-sicbo": {
      "command": "python",
      "args": ["mcp_servers/telegram_mcp.py"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
        "TELEGRAM_ADMIN_CHAT_ID": "${TELEGRAM_ADMIN_CHAT_ID}"
      },
      "description": "Telegram MCP cho Sicbo: giao task, nhận phản hồi, hỏi status qua Telegram"
    }
  }
}
