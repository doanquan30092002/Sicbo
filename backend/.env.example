# ==================== Database ====================
# Supabase PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ==================== JWT ====================
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=PLACEHOLDER_64_HEX_CHARS_GENERATE_BEFORE_DEPLOY
JWT_REFRESH_SECRET_KEY=PLACEHOLDER_REFRESH_64_HEX_CHARS_GENERATE_BEFORE_DEPLOY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Telegram Bot ====================
# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=PLACEHOLDER_BOT_TOKEN
# Comma-separated list các telegram user ID có quyền admin
TELEGRAM_ADMIN_IDS=
# Chat ID nhóm/channel nhận thông báo admin (rút tiền pending, lỗi, ...)
TELEGRAM_ADMIN_CHAT_ID=

# ==================== SePay (Payment Webhook) ====================
# Lấy từ dashboard SePay sau khi tạo webhook
# Server sẽ verify HMAC-SHA256(body, secret) trước khi credit balance
SEPAY_WEBHOOK_SECRET=PLACEHOLDER_SEPAY_SECRET

# ==================== Tài khoản nhận nạp ====================
# Người chơi sẽ chuyển khoản vào tài khoản này với transfer_content code (NAP001xxx)
BANK_ACCOUNT_NO=PLACEHOLDER_SO_TK
BANK_ACCOUNT_NAME=PLACEHOLDER_TEN_TK
BANK_NAME=VietinBank
MOMO_PHONE=PLACEHOLDER_SDT_MOMO

# ==================== XSMB API (xosonhanh.vn) ====================
# 500 req/day/IP, không cần API key
XSMB_API_LATEST=https://xosonhanh.vn/wp-json/xosonhanh/v1/latest/MB
XSMB_API_HISTORY=https://xosonhanh.vn/wp-json/xosonhanh/v1/history

# ==================== App ====================
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
DEBUG=false
